### 3. Firebase & Firestore Security Rules

#### `firestore.rules`
Ganti `OWNER_EMAIL_ANDA@gmail.com` dengan email akun Firebase Auth pemilik yang sama dengan `VITE_OWNER_EMAIL`.
```javascript
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'OWNER_EMAIL_ANDA@gmail.com';
    }

    // Koleksi publik proyek
    match /projects/{projectId} {
      allow read: if true;
      allow create, delete: if isOwner();
      // Publik hanya boleh menaikkan click count (+1), admin boleh mengubah semua field
      allow update: if isOwner() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1
      );
    }

    // Koleksi publik komentar global
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'likes', 'pinned', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.likes == 0
        && request.resource.data.pinned == false;
      // Publik hanya boleh like (+1 / -1), admin boleh pin atau edit
      allow update: if isOwner() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && (
          request.resource.data.likes == resource.data.likes + 1 ||
          request.resource.data.likes == resource.data.likes - 1
        )
      );
      allow delete: if isOwner();
    }

    // Statistik kunjungan publik (dokumen 'stats')
    match /visits/{docId} {
      allow read: if true;
      allow create, update: if docId == 'stats'
        && request.resource.data.keys().hasAll(['total', 'today', 'lastVisit']);
      allow delete: if isOwner();
    }

    // Analitik harian (total kunjungan & klik per hari)
    match /analytics/{dayId} {
      allow read: if isOwner();
      allow create, update: if request.resource.data.keys().hasAll(['date', 'visits', 'clicks']);
      allow delete: if isOwner();
    }

    // Koleksi pribadi developer (hanya pemilik yang login)
    match /customCollections/{collectionId} {
      allow read, write: if isOwner();

      match /items/{itemId} {
        allow read, write: if isOwner();
      }
    }
  }
}
```
> **Catatan Penting:** Jika login email/password diaktifkan tanpa verifikasi email, sesuaikan baris `email_verified == true` atau pastikan email pemilik sudah terverifikasi. Untuk Google Login, `email_verified` otomatis `true`.

