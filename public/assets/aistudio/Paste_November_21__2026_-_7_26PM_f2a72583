### 7. Route 2: Dashboard Pribadi `/developer` (`src/pages/DeveloperPage.jsx`)

Tampilan dibuat **sangat berbeda** dari `/`: dense admin panel, default gelap (`dark`), sidebar di desktop (`lg:flex-row`), bottom navigation di mobile (`lg:hidden fixed bottom-0`), tidak di-index mesin pencari (`noindex, nofollow`), dan tidak mengambil data apa pun sebelum login berhasil sebagai pemilik.

Menyediakan 5 bagian utama:
1. **Ringkasan (Overview):** Total Proyek, Total Kunjungan, Total Klik, Total Komentar.
2. **Proyek (CRUD Table):** Pencarian, filter kategori, pengurutan (`sort`), tambah/edit/hapus.
3. **Komentar (Moderasi):** Pencarian, filter semua/disematkan, sematkan/lepas, hapus.
4. **Analitik (Visits & Clicks):** Grafik batang harian + tabel kunjungan & klik per hari.
5. **Database Kustom (Generic Database):** Buat koleksi baru dari nol dengan definisi kolom bebas (`teks`, `angka`, `tanggal`, `centang`), lengkap dengan tabel CRUD, pencarian, dan filter untuk tiap koleksi pribadi.

```jsx
import { useEffect, useMemo, useState } from 'react';
import {
  addDoc,
  collection,
  deleteDoc,
  doc,
  onSnapshot,
  orderBy,
  query,
  serverTimestamp,
  updateDoc,
  writeBatch
} from 'firebase/firestore';
import {
  ArrowUpDown,
  BarChart3,
  Database,
  ExternalLink,
  FolderKanban,
  LayoutDashboard,
  LogIn,
  LogOut,
  MessageSquare,
  MousePointerClick,
  Pencil,
  Pin,
  PinOff,
  Plus,
  Search,
  Trash2,
  Users
} from 'lucide-react';
import { db } from '../firebase';
import { useAuth } from '../context/AuthContext';
import { formatTanggal, normalizeUrl } from '../utils/format';
import Modal from '../components/Modal';
import Toast from '../components/Toast';

const FIELD_TYPES = [
  { id: 'text', label: 'Teks' },
  { id: 'number', label: 'Angka' },
  { id: 'date', label: 'Tanggal' },
  { id: 'boolean', label: 'Status (Ya/Tidak)' }
];

export default function DeveloperPage() {
  const { user, isOwner, loading: authLoading, loginWithGoogle, loginWithEmail, logout } = useAuth();

  const [activeTab, setActiveTab] = useState('overview');
  const [toastMsg, setToastMsg] = useState('');

  // Login Form
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [loginError, setLoginError] = useState('');
  const [submittingLogin, setSubmittingLogin] = useState(false);

  // Data States (Hanya dimuat setelah login pemilik terverifikasi)
  const [projects, setProjects] = useState([]);
  const [comments, setComments] = useState([]);
  const [visitStats, setVisitStats] = useState({ total: 0, today: 0 });
  const [analytics, setAnalytics] = useState([]);
  const [customCollections, setCustomCollections] = useState([]);

  // Projects Table Controls
  const [projSearch, setProjSearch] = useState('');
  const [projCategory, setProjCategory] = useState('Semua');
  const [projSort, setProjSort] = useState({ key: 'order', dir: 'asc' });
  const [projModalOpen, setProjModalOpen] = useState(false);
  const [editingProj, setEditingProj] = useState(null);
  const [projForm, setProjForm] = useState({ title: '', description: '', url: '', category: '' });

  // Comments Table Controls
  const [commSearch, setCommSearch] = useState('');
  const [commFilter, setCommFilter] = useState('all'); // 'all' | 'pinned'

  // Custom Database States
  const [selectedColId, setSelectedColId] = useState(null);
  const [colItems, setColItems] = useState([]);
  const [colSearch, setColSearch] = useState('');
  const [colFilterField, setColFilterField] = useState('all');
  const [newColModalOpen, setNewColModalOpen] = useState(false);
  const [newColName, setNewColName] = useState('');
  const [newColDesc, setNewColDesc] = useState('');
  const [newColFields, setNewColFields] = useState([{ id: 'f1', name: '', type: 'text' }]);
  const [itemModalOpen, setItemModalOpen] = useState(false);
  const [editingItem, setEditingItem] = useState(null);
  const [itemDataForm, setItemDataForm] = useState({});

  const showToast = (msg) => {
    setToastMsg(msg);
    setTimeout(() => setToastMsg(''), 2600);
  };

  // Pastikan meta robots noindex & default tema gelap untuk /developer
  useEffect(() => {
    document.title = 'Panel Developer - sainbyte';
    document.documentElement.classList.add('dark');

    let metaRobots = document.querySelector('meta[name="robots"]');
    const createdMeta = !metaRobots;
    if (!metaRobots) {
      metaRobots = document.createElement('meta');
      metaRobots.name = 'robots';
      document.head.appendChild(metaRobots);
    }
    const prevContent = metaRobots.content;
    metaRobots.content = 'noindex, nofollow, noarchive';

    return () => {
      if (createdMeta) {
        metaRobots.remove();
      } else {
        metaRobots.content = prevContent || '';
      }
      const savedTheme = localStorage.getItem('sainbyte_theme') || 'system';
      const sysDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const shouldBeDark = savedTheme === 'system' ? sysDark : savedTheme === 'dark';
      document.documentElement.classList.toggle('dark', shouldBeDark);
    };
  }, []);

  // Subscribe data HANYA jika isOwner === true
  useEffect(() => {
    if (!isOwner) {
      setProjects([]);
      setComments([]);
      setAnalytics([]);
      setCustomCollections([]);
      return;
    }

    const unsubProj = onSnapshot(
      query(collection(db, 'projects'), orderBy('order', 'asc')),
      (snap) => setProjects(snap.docs.map((d) => ({ id: d.id, ...d.data() })))
    );

    const unsubComm = onSnapshot(
      query(collection(db, 'comments'), orderBy('createdAt', 'desc')),
      (snap) => setComments(snap.docs.map((d) => ({ id: d.id, ...d.data() })))
    );

    const unsubVisit = onSnapshot(doc(db, 'visits', 'stats'), (snap) => {
      if (snap.exists()) setVisitStats(snap.data());
    });

    const unsubAnalytics = onSnapshot(
      query(collection(db, 'analytics'), orderBy('date', 'desc')),
      (snap) => setAnalytics(snap.docs.map((d) => ({ id: d.id, ...d.data() })))
    );

    const unsubCustomCols = onSnapshot(
      query(collection(db, 'customCollections'), orderBy('createdAt', 'asc')),
      (snap) => {
        const cols = snap.docs.map((d) => ({ id: d.id, ...d.data() }));
        setCustomCollections(cols);
        if (cols.length > 0) {
          setSelectedColId((prev) => (cols.some((c) => c.id === prev) ? prev : cols[0].id));
        } else {
          setSelectedColId(null);
        }
      }
    );

    return () => {
      unsubProj();
      unsubComm();
      unsubVisit();
      unsubAnalytics();
      unsubCustomCols();
    };
  }, [isOwner]);

  // Subscribe item untuk koleksi kustom yang sedang dipilih
  useEffect(() => {
    if (!isOwner || !selectedColId) {
      setColItems([]);
      return;
    }
    const unsub = onSnapshot(
      query(collection(db, 'customCollections', selectedColId, 'items'), orderBy('createdAt', 'desc')),
      (snap) => setColItems(snap.docs.map((d) => ({ id: d.id, ...d.data() })))
    );
    return () => unsub();
  }, [isOwner, selectedColId]);

  const handleLoginEmail = async (e) => {
    e.preventDefault();
    setSubmittingLogin(true);
    setLoginError('');
    try {
      await loginWithEmail(email, password);
    } catch {
      setLoginError('Email atau kata sandi tidak valid.');
    } finally {
      setSubmittingLogin(false);
    }
  };

  const handleLoginGoogle = async () => {
    setSubmittingLogin(true);
    setLoginError('');
    try {
      await loginWithGoogle();
    } catch {
      setLoginError('Gagal masuk dengan akun Google.');
    } finally {
      setSubmittingLogin(false);
    }
  };

  const totalClicks = useMemo(
    () => projects.reduce((sum, p) => sum + (p.clicks || 0), 0),
    [projects]
  );

  const projectCategories = useMemo(() => {
    const set = new Set(projects.map((p) => (p.category || 'Umum').trim() || 'Umum'));
    return ['Semua', ...Array.from(set).sort()];
  }, [projects]);

  const filteredProjects = useMemo(() => {
    const q = projSearch.trim().toLowerCase();
    const list = projects.filter((p) => {
      const cat = (p.category || 'Umum').trim() || 'Umum';
      const matchCat = projCategory === 'Semua' || cat === projCategory;
      const matchQ =
        !q ||
        (p.title || '').toLowerCase().includes(q) ||
        (p.url || '').toLowerCase().includes(q) ||
        cat.toLowerCase().includes(q);
      return matchCat && matchQ;
    });

    return [...list].sort((a, b) => {
      const dir = projSort.dir === 'asc' ? 1 : -1;
      if (projSort.key === 'clicks') return ((a.clicks || 0) - (b.clicks || 0)) * dir;
      if (projSort.key === 'title') return (a.title || '').localeCompare(b.title || '') * dir;
      if (projSort.key === 'category') return (a.category || '').localeCompare(b.category || '') * dir;
      if (projSort.key === 'updatedAt') {
        const ta = a.updatedAt?.toMillis ? a.updatedAt.toMillis() : 0;
        const tb = b.updatedAt?.toMillis ? b.updatedAt.toMillis() : 0;
        return (ta - tb) * dir;
      }
      return ((a.order ?? 0) - (b.order ?? 0)) * dir;
    });
  }, [projects, projSearch, projCategory, projSort]);

  const toggleSort = (key) => {
    setProjSort((prev) =>
      prev.key === key
        ? { key, dir: prev.dir === 'asc' ? 'desc' : 'asc' }
        : { key, dir: 'asc' }
    );
  };

  const handleSaveProject = async (e) => {
    e.preventDefault();
    if (!projForm.title.trim() || !projForm.url.trim()) return;
    try {
      const payload = {
        title: projForm.title.trim(),
        description: projForm.description.trim(),
        url: normalizeUrl(projForm.url),
        category: projForm.category.trim() || 'Umum',
        updatedAt: serverTimestamp()
      };
      if (editingProj) {
        await updateDoc(doc(db, 'projects', editingProj.id), payload);
        showToast('Proyek diperbarui');
      } else {
        const nextOrder = projects.length > 0 ? Math.max(...projects.map((p) => p.order ?? 0)) + 1 : 0;
        await addDoc(collection(db, 'projects'), {
          ...payload,
          clicks: 0,
          order: nextOrder,
          createdAt: serverTimestamp()
        });
        showToast('Proyek ditambahkan');
      }
      setProjModalOpen(false);
    } catch (err) {
      showToast('Gagal menyimpan proyek');
      console.error(err);
    }
  };

  const handleDeleteProject = async (id) => {
    try {
      await deleteDoc(doc(db, 'projects', id));
