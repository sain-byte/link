    e.preventDefault();
    const expectedPin = import.meta.env.VITE_ADMIN_PIN;
    if (!expectedPin) {
      setPinError('VITE_ADMIN_PIN belum dikonfigurasi.');
      return;
    }
    if (pinInput.trim() !== String(expectedPin).trim()) {
      setPinError('PIN salah.');
      return;
    }
    setPinError('');
    setIsPinVerified(true);

    if (isOwner) {
      setPinModalOpen(false);
      showToast('Mode admin aktif');
      const cb = pendingAction;
      setPendingAction(null);
      cb?.();
    }
  };

  const handleInlineGoogleAuth = async () => {
    setAuthLoading(true);
    setPinError('');
    try {
      await loginWithGoogle();
      setPinModalOpen(false);
      showToast('Mode admin aktif');
      const cb = pendingAction;
      setPendingAction(null);
      cb?.();
    } catch (err) {
      setPinError('Login Google gagal atau bukan akun pemilik.');
      console.error(err);
    } finally {
      setAuthLoading(false);
    }
  };

  const handleInlineEmailAuth = async (e) => {
    e.preventDefault();
    setAuthLoading(true);
    setPinError('');
    try {
      await loginWithEmail(authEmail, authPass);
      setPinModalOpen(false);
      showToast('Mode admin aktif');
      const cb = pendingAction;
      setPendingAction(null);
      cb?.();
    } catch (err) {
      setPinError('Email atau kata sandi salah.');
      console.error(err);
    } finally {
      setAuthLoading(false);
    }
  };

  const openAddModal = () => {
    requireAdmin(() => {
      setEditingProject(null);
      setFormState({ title: '', description: '', url: '', category: '' });
      setProjectModalOpen(true);
    });
  };

  const openEditModal = (project) => {
    requireAdmin(() => {
      setEditingProject(project);
      setFormState({
        title: project.title || '',
        description: project.description || '',
        url: project.url || '',
        category: project.category || ''
      });
      setProjectModalOpen(true);
    });
  };

  const handleSaveProject = async (e) => {
    e.preventDefault();
    if (!formState.title.trim() || !formState.url.trim()) {
      showToast('Judul dan URL wajib diisi');
      return;
    }
    setSaving(true);
    try {
      const payload = {
        title: formState.title.trim(),
        description: formState.description.trim(),
        url: normalizeUrl(formState.url),
        category: formState.category.trim() || 'Umum',
        updatedAt: serverTimestamp()
      };

      if (editingProject) {
        await updateDoc(doc(db, 'projects', editingProject.id), payload);
        showToast('Proyek diperbarui');
      } else {
        const nextOrder =
          projects.length > 0
            ? Math.max(...projects.map((p) => p.order ?? 0)) + 1
            : 0;
        await addDoc(collection(db, 'projects'), {
          ...payload,
          clicks: 0,
          order: nextOrder,
          createdAt: serverTimestamp()
        });
        showToast('Proyek ditambahkan');
      }
      setProjectModalOpen(false);
    } catch (err) {
      showToast('Gagal menyimpan proyek');
      console.error(err);
    } finally {
      setSaving(false);
    }
  };

  const handleDeleteProject = (project) => {
    requireAdmin(async () => {
      try {
        await deleteDoc(doc(db, 'projects', project.id));
        showToast('Proyek dihapus');
      } catch (err) {
        showToast('Gagal menghapus proyek');
        console.error(err);
      }
    });
  };

  const handleOpenLink = async (project) => {
    const targetUrl = normalizeUrl(project.url);
    window.open(targetUrl, '_blank', 'noopener,noreferrer');

    try {
      await updateDoc(doc(db, 'projects', project.id), {
        clicks: increment(1)
      });

      const todayKey = getTodayKey();
      const analyticRef = doc(db, 'analytics', todayKey);
      const snap = await getDoc(analyticRef);
      if (!snap.exists()) {
        await setDoc(analyticRef, { date: todayKey, visits: 0, clicks: 1 });
      } else {
        await setDoc(analyticRef, { date: todayKey, clicks: increment(1) }, { merge: true });
      }
    } catch (err) {
      console.error(err);
    }
  };

  const handleCopyLink = async (project) => {
    try {
      await navigator.clipboard.writeText(normalizeUrl(project.url));
      setCopiedId(project.id);
      showToast('Tautan disalin');
      setTimeout(() => setCopiedId(null), 1600);
    } catch {
      showToast('Gagal menyalin tautan');
    }
  };

  const persistOrder = async (newList) => {
    try {
      const batch = writeBatch(db);
      newList.forEach((item, index) => {
        batch.update(doc(db, 'projects', item.id), { order: index });
      });
      await batch.commit();
      showToast('Urutan disimpan');
    } catch (err) {
      showToast('Gagal mengubah urutan');
      console.error(err);
    }
  };

  const handleDropOnCard = async (targetId) => {
    if (!isAdminActive || !draggedId || draggedId === targetId) return;
    const fromIdx = projects.findIndex((p) => p.id === draggedId);
    const toIdx = projects.findIndex((p) => p.id === targetId);
    if (fromIdx === -1 || toIdx === -1) return;

    const updated = [...projects];
    const [moved] = updated.splice(fromIdx, 1);
    updated.splice(toIdx, 0, moved);
    setDraggedId(null);
    await persistOrder(updated);
  };

  const handleMoveStep = async (project, direction) => {
    if (!isAdminActive) return;
    const idx = projects.findIndex((p) => p.id === project.id);
    const swapIdx = idx + direction;
    if (swapIdx < 0 || swapIdx >= projects.length) return;
    const updated = [...projects];
    [updated[idx], updated[swapIdx]] = [updated[swapIdx], updated[idx]];
    await persistOrder(updated);
  };

  const handleExportJson = () => {
    if (projects.length === 0) {
      showToast('Belum ada data untuk diekspor');
      return;
    }
    const clean = projects.map(({ title, description, url, category, clicks, order }) => ({
      title,
      description,
      url,
      category,
      clicks: clicks || 0,
      order: order ?? 0
    }));
    const blob = new Blob([JSON.stringify(clean, null, 2)], { type: 'application/json' });
    const dlUrl = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = dlUrl;
    a.download = `sainbyte-projects-${getTodayKey()}.json`;
    a.click();
    URL.revokeObjectURL(dlUrl);
    showToast('JSON berhasil diekspor');
  };

  const handleImportJson = async (e) => {
    const file = e.target.files?.[0];
    e.target.value = '';
    if (!file) return;
    try {
      const text = await file.text();
      const parsed = JSON.parse(text);
      if (!Array.isArray(parsed)) {
        showToast('Format JSON harus berupa array');
        return;
      }
      const batch = writeBatch(db);
      let baseOrder =
        projects.length > 0 ? Math.max(...projects.map((p) => p.order ?? 0)) + 1 : 0;

      parsed.forEach((item) => {
        if (item?.title && item?.url) {
          const ref = doc(collection(db, 'projects'));
          batch.set(ref, {
            title: String(item.title).trim(),
            description: String(item.description || '').trim(),
            url: normalizeUrl(String(item.url)),
            category: String(item.category || 'Umum').trim() || 'Umum',
            clicks: Number(item.clicks) || 0,
            order: baseOrder++,
            createdAt: serverTimestamp(),
            updatedAt: serverTimestamp()
          });
        }
      });
      await batch.commit();
      showToast('Impor JSON berhasil');
    } catch (err) {
      showToast('Gagal mengimpor file JSON');
      console.error(err);
    }
  };

  const handleInstallPwa = async () => {
    if (!deferredPrompt) return;
    deferredPrompt.prompt();
    const { outcome } = await deferredPrompt.userChoice;
    if (outcome === 'accepted') {
      setDeferredPrompt(null);
    }
  };

  // Lebar konten: 80% centered di mobile, mendukung mode Desktop / Mobile
  const containerClass =
    viewMode === 'mobile'
      ? 'w-[80%] max-w-md mx-auto'
      : viewMode === 'desktop'
      ? 'w-[92%] max-w-6xl mx-auto'
      : 'w-[80%] md:w-[88%] max-w-5xl mx-auto';

  const gridClass =
    viewMode === 'mobile'
      ? 'grid-cols-1'
      : viewMode === 'desktop'
      ? 'grid-cols-3'
      : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3';

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-950 dark:text-slate-100 transition-colors duration-200 flex flex-col">
      <Toast message={toastMsg} />

      <main className={`${containerClass} py-8 sm:py-10 flex-1`}>
        {/* Header polos tanpa logo, tanpa ikon, tanpa icon box */}
        <header className="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-6 border-b border-slate-200 dark:border-slate-800">
          <div>
            <h1
              onClick={handleSecretTap}
              className="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 select-none cursor-default inline-block"
            >
              sainbyte
            </h1>
            <p className="text-sm text-slate-600 dark:text-slate-400 mt-0.5">
              dashboard list project
            </p>
          </div>

          <div className="flex flex-wrap items-center gap-2">
            {deferredPrompt && (
              <button
                type="button"
                onClick={handleInstallPwa}
                className="px-3 py-2 text-xs font-medium rounded-xl accent-soft-bg accent-text hover:opacity-90 transition-opacity"
              >
                Install Aplikasi
              </button>
            )}

            <button
              type="button"
              onClick={() =>
                setViewMode((v) =>
                  v === 'auto' ? 'desktop' : v === 'desktop' ? 'mobile' : 'auto'
                )
              }
              title="Ubah mode tampilan"
              className="p-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            >
              {viewMode === 'desktop' ? (
                <Monitor className="w-4 h-4" />
              ) : viewMode === 'mobile' ? (
                <Smartphone className="w-4 h-4" />
              ) : (
                <Monitor className="w-4 h-4 opacity-70" />
              )}
            </button>

            <button
              type="button"
              onClick={() => setThemeModalOpen(true)}
              title="Tema dan Warna"
              className="p-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
            >
              <Palette className="w-4 h-4" />
            </button>

            <button
              type="button"
              onClick={() => {
                if (isAdminActive) {
                  setIsPinVerified(false);
                  showToast('Mode admin dikunci');
                } else {
                  requireAdmin();
                }
              }}
              className={`inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-medium border transition-colors ${
                isAdminActive
                  ? 'accent-bg text-white border-transparent'
                  : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
              }`}
            >
              {isAdminActive ? <Unlock className="w-3.5 h-3.5" /> : <Lock className="w-3.5 h-3.5" />}
              <span>{isAdminActive ? 'Admin Aktif' : 'Admin'}</span>
            </button>
          </div>
        </header>

        {/* Toolbar Pencarian & Aksi */}
        <section className="mt-6 space-y-4">
          <div className="flex flex-col sm:flex-row gap-2.5">
            <div className="relative flex-1">
              <Search className="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
              <input
                type="text"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
                placeholder="Cari proyek berdasarkan judul, deskripsi, atau URL..."
                className="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 placeholder:text-slate-400 accent-ring"
              />
            </div>

            <div className="flex flex-wrap items-center gap-2">
              <button
                type="button"
                onClick={openAddModal}
                className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl accent-bg text-white text-sm font-medium transition-colors"
              >
                <Plus className="w-4 h-4" />
                <span>Tambah</span>
              </button>

              <button
                type="button"
                onClick={handleExportJson}
                title="Ekspor JSON"
                className="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              >
                <Download className="w-4 h-4" />
                <span>Ekspor</span>
              </button>

              <button
                type="button"
                onClick={() => requireAdmin(() => fileInputRef.current?.click())}
                title="Impor JSON"
                className="inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-200 text-xs font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
              >
                <Upload className="w-4 h-4" />
                <span>Impor</span>
              </button>
              <input
                ref={fileInputRef}
                type="file"
                accept="application/json"
                onChange={handleImportJson}
                className="hidden"
              />
            </div>
          </div>

          {/* Filter Kategori + Total */}
          <div className="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onClick={() => setSelectedCategory('Semua')}
              className={`px-3 py-1.5 rounded-full text-xs font-medium transition-colors ${
                selectedCategory === 'Semua'
                  ? 'accent-bg text-white'
                  : 'bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800'
              }`}
            >
              Semua ({projects.length})
            </button>
            {categoryStats.map(([cat, count]) => (
              <button
                key={cat}
                type="button"
                onClick={() => setSelectedCategory(cat)}
                className={`px-3 py-1.5 rounded-full text-xs font-medium transition-colors ${
                  selectedCategory === cat
                    ? 'accent-bg text-white'
                    : 'bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800'
                }`}
              >
                {cat} ({count})
              </button>
            ))}
          </div>
        </section>

        {/* Daftar Kartu Proyek */}
        <section className="mt-6">
          {loading ? (
            <div className={`grid ${gridClass} gap-4`}>
              {[1, 2, 3].map((i) => (
                <div
                  key={i}
                  className="h-40 rounded-2xl bg-slate-200/70 dark:bg-slate-800/60 animate-pulse"
                />
              ))}
            </div>
          ) : filteredProjects.length === 0 ? (
            <div className="text-center py-14 px-4 rounded-2xl border border-dashed border-slate-300 dark:border-slate-800 bg-white dark:bg-slate-900">
              <p className="text-sm text-slate-600 dark:text-slate-400 mb-4">
                Belum ada data
              </p>
              <button
                type="button"
                onClick={openAddModal}
                className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl accent-bg text-white text-sm font-medium transition-colors"
              >
                <Plus className="w-4 h-4" />
                <span>Tambah Proyek Baru</span>
              </button>
            </div>
          ) : (
            <div className={`grid ${gridClass} gap-4`}>
              {filteredProjects.map((project, idx) => (
                <article
                  key={project.id}
                  draggable={isAdminActive}
                  onDragStart={() => setDraggedId(project.id)}
                  onDragOver={(e) => {
                    if (isAdminActive) e.preventDefault();
                  }}
                  onDrop={() => handleDropOnCard(project.id)}
                  className={`group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 shadow-sm hover:shadow-md transition-all flex flex-col justify-between animate-fade-in-up ${
                    draggedId === project.id ? 'opacity-50 scale-[0.98]' : ''
                  }`}
                >
                  <div>
                    <div className="flex items-start justify-between gap-2">
                      <span className="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-medium accent-soft-bg accent-text">
                        {project.category || 'Umum'}
                      </span>

                      {isAdminActive && (
                        <div className="flex items-center gap-1 text-slate-400">
                          <span className="cursor-grab hidden sm:inline-flex p-1" title="Seret untuk mengurutkan">
                            <GripVertical className="w-3.5 h-3.5" />
                          </span>
                          <button
                            type="button"
                            onClick={() => handleMoveStep(project, -1)}
                            disabled={idx === 0}
                            className="p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30"
                            title="Geser naik"
                          >
                            <ArrowUp className="w-3.5 h-3.5" />
                          </button>
                          <button
                            type="button"
                            onClick={() => handleMoveStep(project, 1)}
                            disabled={idx === filteredProjects.length - 1}
                            className="p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 disabled:opacity-30"
                            title="Geser turun"
                          >
                            <ArrowDown className="w-3.5 h-3.5" />
                          </button>
                        </div>
                      )}
                    </div>

                    <h2 className="mt-3 text-base font-semibold text-slate-900 dark:text-slate-100 break-words">
                      {project.title}
                    </h2>

                    {project.description && (
                      <p className="mt-1.5 text-sm text-slate-600 dark:text-slate-400 line-clamp-3 break-words">
                        {project.description}
                      </p>
                    )}

                    <p className="mt-2 text-xs text-slate-500 dark:text-slate-400 truncate">
                      {project.url}
                    </p>
                  </div>

                  <div className="mt-4 pt-3 border-t border-slate-100 dark:border-slate-800 space-y-3">
                    <div className="flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
                      <span className="tabular-nums">{project.clicks || 0} klik</span>
                      <span>Diperbarui {formatTanggal(project.updatedAt || project.createdAt)}</span>
                    </div>

                    <div className="flex items-center gap-2">
                      <button
                        type="button"
                        onClick={() => handleOpenLink(project)}
                        className="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl accent-bg text-white text-xs font-medium transition-colors"
                      >
                        <ExternalLink className="w-3.5 h-3.5" />
                        <span>Buka</span>
                      </button>

                      <button
                        type="button"
                        onClick={() => handleCopyLink(project)}
                        title="Salin tautan"
                        className="p-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                      >
                        {copiedId === project.id ? (
                          <Check className="w-3.5 h-3.5 text-emerald-500" />
                        ) : (
                          <Copy className="w-3.5 h-3.5" />
                        )}
                      </button>

                      {isAdminActive && (
                        <>
                          <button
                            type="button"
                            onClick={() => openEditModal(project)}
                            title="Edit"
                            className="p-2 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
                          >
                            <Pencil className="w-3.5 h-3.5" />
                          </button>
                          <button
                            type="button"
                            onClick={() => handleDeleteProject(project)}
                            title="Hapus"
                            className="p-2 rounded-xl border border-rose-200 dark:border-rose-900/60 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors"
                          >
                            <Trash2 className="w-3.5 h-3.5" />
                          </button>
                        </>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>

        {/* Global ChatBox */}
        <ChatBox
          isAdminUnlocked={isAdminActive}
          onRequireAdmin={requireAdmin}
          showToast={showToast}
        />
      </main>

      {/* Footer Visit Counter */}
      <footer className="border-t border-slate-200 dark:border-slate-800 py-5 px-4 bg-white/70 dark:bg-slate-900/50">
        <VisitCounter />
      </footer>

      {/* Modal Verifikasi Admin (PIN + Firebase Auth) */}
      <Modal
        open={pinModalOpen}
        onClose={() => {
          setPinModalOpen(false);
          setPendingAction(null);
        }}
        title="Verifikasi Admin"
      >
        <div className="space-y-4">
          {!isPinVerified ? (
            <form onSubmit={handlePinSubmit} className="space-y-3">
              <div>
                <label className="block text-xs font-medium text-slate-600 dark:text-slate-400 mb-1.5">
                  Masukkan PIN Admin
                </label>
                <input
                  type="password"
                  value={pinInput}
                  onChange={(e) => setPinInput(e.target.value)}
                  autoFocus
                  placeholder="PIN"
                  className="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 accent-ring"
                />
              </div>
              {pinError && <p className="text-xs text-rose-600 dark:text-rose-400">{pinError}</p>}
              <button
                type="submit"
                className="w-full py-2.5 rounded-xl accent-bg text-white text-sm font-medium transition-colors"
              >
                Lanjutkan
              </button>
            </form>
          ) : (
            <div className="space-y-4">
              <p className="text-xs text-slate-600 dark:text-slate-400">
                PIN terverifikasi. Masuk dengan akun pemilik Firebase agar perubahan dapat disimpan ke database.
              </p>

              <button
                type="button"
                disabled={authLoading}
                onClick={handleInlineGoogleAuth}
                className="w-full py-2.5 px-4 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
              >
                {authLoading ? 'Memproses...' : 'Masuk dengan Google'}
              </button>

              <form onSubmit={handleInlineEmailAuth} className="space-y-2.5 pt-2 border-t border-slate-200 dark:border-slate-800">
                <input
                  type="email"
                  required
                  value={authEmail}
                  onChange={(e) => setAuthEmail(e.target.value)}
                  placeholder="Email pemilik"
                  className="w-full px-3.5 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-slate-100 accent-ring"
                />
                <input
                  type="password"
                  required
                  value={authPass}
                  onChange={(e) => setAuthPass(e.target.value)}
                  placeholder="Kata sandi"
