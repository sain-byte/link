#### `src/components/VisitCounter.jsx`
Menghitung kunjungan total dan hari ini secara otomatis, disimpan ke Firestore (`visits/stats` dan `analytics/{YYYY-MM-DD}`), dan ditampilkan dengan animasi count-up.
```jsx
import { useEffect, useRef, useState } from 'react';
import { doc, getDoc, increment, onSnapshot, setDoc } from 'firebase/firestore';
import { db } from '../firebase';
import { getTodayKey } from '../utils/format';

export default function VisitCounter() {
  const [stats, setStats] = useState({ total: 0, today: 0 });
  const [displayTotal, setDisplayTotal] = useState(0);
  const [displayToday, setDisplayToday] = useState(0);
  const recordedRef = useRef(false);

  useEffect(() => {
    const todayKey = getTodayKey();
    const visitRef = doc(db, 'visits', 'stats');
    const analyticsRef = doc(db, 'analytics', todayKey);

    const recordVisit = async () => {
      if (recordedRef.current) return;
      recordedRef.current = true;
      if (sessionStorage.getItem('sainbyte_visited') === todayKey) return;

      try {
        const snap = await getDoc(visitRef);
        if (!snap.exists()) {
          await setDoc(visitRef, {
            total: 1,
            today: 1,
            lastVisit: todayKey
          });
        } else {
          const data = snap.data();
          const isSameDay = data.lastVisit === todayKey;
          await setDoc(
            visitRef,
            {
              total: (data.total || 0) + 1,
              today: isSameDay ? (data.today || 0) + 1 : 1,
              lastVisit: todayKey
            },
            { merge: true }
          );
        }

        const analyticSnap = await getDoc(analyticsRef);
        if (!analyticSnap.exists()) {
          await setDoc(analyticsRef, {
            date: todayKey,
            visits: 1,
            clicks: 0
          });
        } else {
          await setDoc(
            analyticsRef,
            {
              date: todayKey,
              visits: increment(1)
            },
            { merge: true }
          );
        }

        sessionStorage.setItem('sainbyte_visited', todayKey);
      } catch (err) {
        console.error('Gagal mencatat kunjungan:', err);
      }
    };

    recordVisit();

    const unsub = onSnapshot(visitRef, (snap) => {
      if (snap.exists()) {
        const data = snap.data();
        const isToday = data.lastVisit === getTodayKey();
        setStats({
          total: data.total || 0,
          today: isToday ? data.today || 0 : 0
        });
      }
    });

    return () => unsub();
  }, []);

  useEffect(() => {
    const duration = 600;
    const startTotal = displayTotal;
    const startToday = displayToday;
    const targetTotal = stats.total;
    const targetToday = stats.today;
    const startTime = performance.now();

    let rafId;
    const step = (now) => {
      const progress = Math.min((now - startTime) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      setDisplayTotal(Math.round(startTotal + (targetTotal - startTotal) * eased));
      setDisplayToday(Math.round(startToday + (targetToday - startToday) * eased));
      if (progress < 1) {
        rafId = requestAnimationFrame(step);
      }
    };
    rafId = requestAnimationFrame(step);
    return () => cancelAnimationFrame(rafId);
  }, [stats.total, stats.today]);

  return (
    <div className="flex flex-wrap items-center justify-center gap-4 text-xs text-slate-600 dark:text-slate-400">
      <span>
        Total Kunjungan:{' '}
        <strong className="text-slate-900 dark:text-slate-100 tabular-nums">
          {displayTotal.toLocaleString('id-ID')}
        </strong>
      </span>
      <span className="opacity-40">•</span>
      <span>
        Hari Ini:{' '}
        <strong className="text-slate-900 dark:text-slate-100 tabular-nums">
          {displayToday.toLocaleString('id-ID')}
        </strong>
      </span>
    </div>
  );
}
