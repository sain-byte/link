rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'sainbyte@gmail.com';
    }

    match /vault/{allPaths=**} {
      allow read: if isOwner();
      allow write: if isOwner()
        && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
