# Firebase Web Config (used for Vercel deployment; AI Studio preview uses firebase-applet-config.json fallback)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firestore Database ID (isi "(default)" atau kosongkan; JANGAN isi URL Realtime Database)
VITE_FIREBASE_DATABASE_ID=

# Owner email & optional Admin PIN for public page lock
VITE_OWNER_EMAIL=
VITE_ADMIN_PIN=
